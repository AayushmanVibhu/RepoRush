# Auth and workspace persistence
MONGODB_URI=
MONGODB_DB=reporush
AUTH_SECRET=
AUTH_URL=http://localhost:3000
GITHUB_ID=
GITHUB_SECRET=

# The catalog source and snapshot provider are independent.
CHALLENGE_CATALOG_SOURCE=legacy
CHALLENGE_STORAGE_PROVIDER=local
CHALLENGE_STORAGE_DIR=.challenge-storage
NEXT_PUBLIC_CHALLENGE_CACHE_MAX_BYTES=16777216

# Required only for the r2 provider.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Optional integrations
E2B_API_KEY=
GEMINI_API_KEY=
SUPERMEMORY_API_KEY=
