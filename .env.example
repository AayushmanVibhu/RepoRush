# MongoDB Atlas connection string. Keep this server-side.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=reporush

# Auth.js
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-secret
GITHUB_ID=replace-with-github-oauth-client-id
GITHUB_SECRET=replace-with-github-oauth-client-secret

# Supermemory v5
SUPERMEMORY_API_KEY=replace-with-supermemory-api-key

# Gemini coding coach (server only)
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Isolated Linux workspaces. Never use NEXT_PUBLIC_ for these values.
E2B_API_KEY=replace-with-e2b-api-key
# Optional prebuilt template with Node, Python, JDK 17+, git, and bash.
# E2B_TEMPLATE=reporush-linux
# Per signed-in user, per UTC day; includes starts and regression runs.
E2B_DAILY_LIMIT=60
