# MongoDB Atlas connection string. Keep this server-side.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=reporush

# Auth.js
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-secret
GITHUB_ID=replace-with-github-oauth-client-id
GITHUB_SECRET=replace-with-github-oauth-client-secret

# Supermemory v5
SUPERMEMORY_API_KEY=replace-with-supermemory-api-key
